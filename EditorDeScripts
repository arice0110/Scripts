<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Mi Editor Pro Mobile (Limpio)</title>
    <style>
        * { box-sizing: border-box; }
        body { margin: 0; display: flex; flex-direction: column; height: 100vh; font-family: sans-serif; background: #121212; overflow: hidden; }

        /* VISTA PREVIA (Mitad superior) */
        #preview {
            flex: 1;
            width: 100%;
            background: white;
            border: none;
        }

        /* CONTENEDOR DEL EDITOR (Mitad inferior) */
        #editor-container {
            flex: 1;
            display: flex;
            flex-direction: column;
            border-top: 2px solid #333;
        }

        /* BARRA DE PESTAÑAS */
        .tabs {
            display: flex;
            background: #1e1e1e;
        }
        .tab-btn {
            flex: 1;
            padding: 12px;
            border: none;
            background: #2d2d2d;
            color: #888;
            cursor: pointer;
            font-weight: bold;
            font-size: 14px;
            outline: none;
        }
        .tab-btn.active {
            background: #1e1e1e;
            color: #007acc;
            border-bottom: 2px solid #007acc;
        }

        /* ÁREAS DE TEXTO */
        .code-area {
            flex: 1;
            display: none;
            position: relative;
        }
        .code-area.active {
            display: block;
        }
        textarea {
            width: 100%;
            height: 100%;
            background: #1e1e1e;
            color: #d4d4d4;
            padding: 15px;
            border: none;
            font-family: 'Courier New', monospace;
            font-size: 15px;
            resize: none;
            outline: none;
        }
    </style>
</head>
<body>

    <iframe id="preview"></iframe>

    <div id="editor-container">
        <div class="tabs">
            <button class="tab-btn active" onclick="openTab(event, 'html-tab')">HTML</button>
            <button class="tab-btn" onclick="openTab(event, 'css-tab')">CSS</button>
            <button class="tab-btn" onclick="openTab(event, 'js-tab')">JS</button>
        </div>

        <div id="html-tab" class="code-area active">
            <textarea id="html-code" placeholder="Escribe HTML aquí..." spellcheck="false"></textarea>
        </div>

        <div id="css-tab" class="code-area">
            <textarea id="css-code" placeholder="Escribe CSS aquí..." spellcheck="false"></textarea>
        </div>

        <div id="js-tab" class="code-area">
            <textarea id="js-code" placeholder="Escribe JS aquí..." spellcheck="false"></textarea>
        </div>
    </div>

    <script>
        const htmlInput = document.getElementById('html-code');
        const cssInput = document.getElementById('css-code');
        const jsInput = document.getElementById('js-code');
        const preview = document.getElementById('preview');

        // Cambiar entre pestañas
        function openTab(evt, tabName) {
            const codeAreas = document.getElementsByClassName("code-area");
            for (let i = 0; i < codeAreas.length; i++) {
                codeAreas[i].classList.remove("active");
            }
            const tabBtns = document.getElementsByClassName("tab-btn");
            for (let i = 0; i < tabBtns.length; i++) {
                tabBtns[i].classList.remove("active");
            }
            document.getElementById(tabName).classList.add("active");
            evt.currentTarget.classList.add("active");
        }

        // Renderizado en tiempo real
        function update() {
            const html = htmlInput.value;
            const css = `<style>${cssInput.value}</style>`;
            const js = `<script>${jsInput.value}<\/script>`;
            
            const fullCode = `
                <!DOCTYPE html>
                <html>
                    <head>
                        <meta charset="UTF-8">
                        ${css}
                    </head>
                    <body>
                        ${html}
                        ${js}
                    </body>
                </html>
            `;

            const frameDoc = preview.contentDocument || preview.contentWindow.document;
            frameDoc.open();
            frameDoc.write(fullCode);
            frameDoc.close();
        }

        // Eventos para actualizar al escribir
        htmlInput.addEventListener('input', update);
        cssInput.addEventListener('input', update);
        jsInput.addEventListener('input', update);

        // Inicializar vacío
        update();
    </script>
</body>
</html>
