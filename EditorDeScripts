<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>Editor Pro Universal</title>
    <style>
        :root { --bg: #0e0e0e; --panel: #1a1a1a; --accent: #47cf73; --text: #fff; --gray: #888; }
        * { box-sizing: border-box; margin: 0; padding: 0; }
        body, html { height: 100%; background: var(--bg); color: var(--text); font-family: monospace; overflow: hidden; }

        /* Setup */
        #setup { position: fixed; inset: 0; z-index: 100; background: var(--bg); padding: 20px; display: flex; flex-direction: column; gap: 10px; overflow-y: auto; }
        textarea { background: #111; border: 1px solid #333; color: #fff; padding: 10px; border-radius: 4px; height: 80px; outline: none; }
        #start-btn { background: var(--accent); color: #000; border: none; padding: 15px; font-weight: bold; border-radius: 4px; margin-top: 10px; }

        /* Editor */
        #main { display: none; height: 100vh; flex-direction: column; }
        .tabs { display: flex; background: #000; }
        .tab { flex: 1; padding: 12px; border: none; background: var(--panel); color: var(--gray); font-weight: bold; font-size: 11px; border-right: 1px solid #000; }
        .tab.active { background: var(--bg); color: #fff; border-bottom: 2px solid var(--accent); }

        .editor-container { height: 30vh; background: var(--bg); position: relative; }
        .code-view { width: 100%; height: 100%; padding: 15px; font-size: 13px; white-space: pre-wrap; word-break: break-all; overflow-y: auto; display: none; }
        .code-view.active { display: block; }
        .cursor { display: inline-block; width: 8px; height: 15px; background: var(--accent); animation: blink 0.7s infinite; }
        @keyframes blink { 50% { opacity: 0; } }

        /* Preview con Marco */
        .preview-zone { flex: 1; background: #000; padding: 10px; display: flex; flex-direction: column; }
        .frame-limit { flex: 1; background: #fff; border: 5px solid #333; border-radius: 4px; overflow: hidden; position: relative; }
        iframe { width: 100%; height: 100%; border: none; background: #fff; }
    </style>
</head>
<body>

<div id="setup">
    <h3 style="text-align:center">Editor de Código</h3>
    <label>HTML</label><textarea id="ih"></textarea>
    <label>CSS</label><textarea id="ic"></textarea>
    <label>JS</label><textarea id="ij"></textarea>
    <button id="start-btn">GENERAR EDITOR</button>
</div>

<div id="main">
    <div class="tabs">
        <button id="th" class="tab active" onclick="sw('h')">HTML</button>
        <button id="tc" class="tab" onclick="sw('c')">CSS</button>
        <button id="tj" class="tab" onclick="sw('j')">JS</button>
    </div>
    <div class="editor-container">
        <div id="vh" class="code-view active" onclick="type('h')"></div>
        <div id="vc" class="code-view" onclick="type('c')"></div>
        <div id="vj" class="code-view" onclick="type('j')"></div>
    </div>
    <div class="preview-zone">
        <div style="font-size:10px; color:var(--gray); margin-bottom:5px;">TIEMPO REAL </div>
        <div class="frame-limit">
            <iframe id="ifr"></iframe>
        </div>
    </div>
</div>

<script>
    const code = { h: { raw: '', cur: '', ok: false }, c: { raw: '', cur: '', ok: false }, j: { raw: '', cur: '', ok: false } };
    const ifr = document.getElementById('ifr');
    let iDoc, sTag, bTag, jsT;

    document.getElementById('start-btn').onclick = () => {
        code.h.raw = document.getElementById('ih').value;
        code.c.raw = document.getElementById('ic').value;
        code.j.raw = document.getElementById('ij').value;
        document.getElementById('setup').style.display = 'none';
        document.getElementById('main').style.display = 'flex';

        iDoc = ifr.contentDocument || ifr.contentWindow.document;
        iDoc.open();
        iDoc.write('<!DOCTYPE html><html><head><style id="s"></style></head><body><div id="b"></div></body></html>');
        iDoc.close();
        sTag = iDoc.getElementById('s');
        bTag = iDoc.getElementById('b');
    };

    function sw(t) {
        ['h','c','j'].forEach(k => {
            document.getElementById('t'+k).classList.toggle('active', k === t);
            document.getElementById('v'+k).classList.toggle('active', k === t);
        });
    }

    function type(t) {
        if (code[t].ok) return;
        let i = 0;
        const view = document.getElementById('v'+t);
        const interval = setInterval(() => {
            if (i < code[t].raw.length) {
                code[t].cur += code[t].raw.charAt(i);
                view.textContent = code[t].cur;
                view.innerHTML += '<span class="cursor"></span>';
                view.scrollTop = view.scrollHeight;

                if (t === 'h') bTag.innerHTML = code.h.cur;
                if (t === 'c') sTag.textContent = code.c.cur;
                if (t === 'j') syncJS(); // Sincronización inteligente
                
                i++;
            } else {
                clearInterval(interval);
                code[t].ok = true;
                view.textContent = code[t].cur;
            }
        }, 20);
    }

    // La clave para que el JS sea universal y no falle:
    function syncJS() {
        clearTimeout(jsT);
        jsT = setTimeout(() => {
            try {
                // Eliminamos cualquier script previo para evitar duplicados
                const old = iDoc.querySelectorAll('.temp-script');
                old.forEach(s => s.remove());

                const s = iDoc.createElement('script');
                s.className = 'temp-script';
                // Solo ejecutamos si el código parece estar completo (ej. tiene llaves cerradas)
                // O simplemente lo intentamos ejecutar en un entorno seguro
                s.textContent = `try { ${code.j.cur} } catch(e) {}`;
                iDoc.body.appendChild(s);
            } catch (e) {}
        }, 100); // Espera 100ms tras la última letra para ejecutar
    }
</script>
</body>
</html>
