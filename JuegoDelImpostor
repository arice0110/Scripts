<!-- AGREGAR ESTA LÍNEA: -->
<button onclick="goBack('roleScreen')" style="background:#333;">⬅️ VOLVER A NOMBRES</button>
</div>

<div id="timerScreen" class="card hidden">
    <h2>⏳ TIEMPO DE JUEGO</h2>
    <div id="timer">00:00</div>
    <!-- AGREGAR ESTOS BOTONES: -->
    <div id="timerControls">
        <button onclick="togglePause()" id="pauseBtn">⏸️ PAUSAR</button>
