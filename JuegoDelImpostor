<p style="margin-top:6px;">🔄 Cambiar categoría cada ronda</p>

<br>
<button onclick="createNames()">🚀 CONTINUAR</button>
</div>

<div id="names" class="card hidden">
    <h3>📝 Nombres de jugadores</h3>
    <div id="nameInputs"></div>
    <button onclick="startGame()">🎮 INICIAR</button>
<!-- AGREGAR ESTA LÍNEA: -->
<button onclick="goBack('names')" style="background:#333;">⬅️ VOLVER A CONFIGURACIÓN</button>
</div>

<div id="roleScreen" class="card hidden">
