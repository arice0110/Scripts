function getSecretWord(category = "aleatorio"){
    // Si se activó "categoría aleatoria", elegir una al azar
    if(category === "aleatorio" || randomCategoryEnabled) {
        const availableCategories = Object.keys(wordCategories).filter(cat => cat !== "aleatorio");
        category = availableCategories[Math.floor(Math.random() * availableCategories.length)];
    }
    
    // Obtener la lista de palabras según categoría
    const wordList = wordCategories[category] || wordCategories["aleatorio"];
    
    // Resetear palabras usadas después de 100 rondas
    if(roundsPlayed >= 100){
        usedWords=[];
        roundsPlayed=0;
    }
    
    // Filtrar palabras ya usadas (solo de la misma categoría)
    let available = wordList.filter(w => !usedWords.includes(w));
    
    // Si no hay palabras disponibles, resetear las usadas de esta categoría
    if(available.length === 0) {
        usedWords = usedWords.filter(w => !wordList.includes(w));
        available = wordList;
    }
    
    let word = available[Math.floor(Math.random()*available.length)];
    usedWords.push(word);
    roundsPlayed++;
    localStorage.setItem("usedWords", JSON.stringify(usedWords));
    localStorage.setItem("roundsPlayed", JSON.stringify(roundsPlayed));
    return word;
}

/* FUNCIÓN DE PISTA */
function getHint(word){
    if(word.length == 1) return word;
    return word[0] + "   " + word[word.length-1];
}

function getRandomImpostors(numPlayers){
    let min = 1;
    let max = numPlayers - 1;
    return Math.floor(Math.random() * (max - min + 1)) + min;
}
function createNames(){
    const num=document.getElementById("numPlayers").value;
    document.getElementById("setup").classList.add("hidden");
    document.getElementById("names").classList.remove("hidden");
    let html="";
    for(let i=0;i<num;i++){
        let value=savedNames[i]||"";
        html+=`<input placeholder="Jugador ${i+1}" id="name${i}" value="${value}"><br>`;
    }
    document.getElementById("nameInputs").innerHTML=html;
}

function startGame(){
    const num=parseInt(document.getElementById("numPlayers").value);
    let impostors;
const randomMode = document.getElementById("randomImpostors").checked;

if(randomMode){
    impostors = getRandomImpostors(num);
}else{
    impostors = Math.min(parseInt(document.getElementById("numImpostors").value), num);
}
    players=[]; savedNames=[];
    for(let i=0;i<num;i++){
        let name=document.getElementById("name"+i).value||"Jugador "+(i+1);
        players.push(name);
        savedNames.push(name);
    }
    localStorage.setItem("savedNames",JSON.stringify(savedNames));

    // Obtener categoría seleccionada
selectedCategory = document.getElementById("categorySelect").value;
// Obtener palabra secreta según categoría
secretWord = getSecretWord(selectedCategory);
    hintEnabled = document.getElementById("enableHint").checked;
    roles=Array(num).fill("inocente");

    let indices=[];
    while(indices.length<impostors){
        let r=Math.floor(Math.random()*num);
        if(!indices.includes(r)) indices.push(r);
    }
    indices.forEach(i=>roles[i]="impostor");

    currentPlayer=0;
    document.getElementById("names").classList.add("hidden");
    document.getElementById("roleScreen").classList.remove("hidden");
    showTurn();
}

function showTurn(){
    document.getElementById("playerTurn").innerText="🎮 Turno de: "+players[currentPlayer];
    document.getElementById("roleResult").classList.add("hidden");
}

function showRole(){
    const div=document.getElementById("roleResult");
    if(roles[currentPlayer]=="impostor"){

        if(hintEnabled){
            let hint = getHint(secretWord);
            div.innerHTML = "😈 ERES IMPOSTOR<br>No conoces la palabra<br><br>💡 Pista:<br><b>"+hint+"</b>";
        }else{
            div.innerHTML = "😈 ERES IMPOSTOR<br>No conoces la palabra";
        }

    }else{
        div.innerHTML="😇 ERES INOCENTE<br><b>"+secretWord+"</b>";
    }
    div.classList.remove("hidden");
}

function nextPlayer(){
    currentPlayer++;
    if(currentPlayer>=players.length) startTimer();
    else showTurn();
}

function startTimer() {
    document.getElementById("roleScreen").classList.add("hidden");
    document.getElementById("timerScreen").classList.remove("hidden");
    
    let totalTime = parseInt(document.getElementById("gameTime").value) * 60;
    remainingTime = totalTime;
    timerPaused = false;
    
    const el = document.getElementById("timer");
    const pauseBtn = document.getElementById("pauseBtn");
    
    // Asegurar que el botón diga "PAUSAR" al iniciar
    pauseBtn.textContent = "⏸️ PAUSAR";
    pauseBtn.style.background = "#444";
    
    // Limpiar cualquier intervalo anterior
    if (timerInterval) {
        clearInterval(timerInterval);
    }
    
    timerInterval = setInterval(() => {
        if (!timerPaused) {
            let m = Math.floor(remainingTime / 60);
            let s = remainingTime % 60;
            el.innerText = `${m}:${s < 10 ? "0" : ""}${s}`;
            
            // Cambiar color cuando queden 30 segundos
            if (remainingTime <= 30) {
                el.style.color = "#ff4444";
                el.style.textShadow = "0 0 12px #ff0000";
            }
            
            remainingTime--;
            
            if (remainingTime < 0) {
                clearInterval(timerInterval);
                showEnd();
            }
        }
    }, 1000);
}

function togglePause() {
    timerPaused = !timerPaused;
    const pauseBtn = document.getElementById("pauseBtn");
    
    if (timerPaused) {
        pauseBtn.textContent = "▶️ REANUDAR";
        pauseBtn.style.background = "#2a7";
        document.getElementById("timer").style.opacity = "0.7";
    } else {
        pauseBtn.textContent = "⏸️ PAUSAR";
        pauseBtn.style.background = "#444";
        document.getElementById("timer").style.opacity = "1";
    }
}

function stopTimer() {
    // Detener el temporizador
    if (timerInterval) {
        clearInterval(timerInterval);
        timerInterval = null;
    }
    
    // Ir directamente a la pantalla final
    showEnd();
}

function showEnd(){
    document.getElementById("timerScreen").classList.add("hidden");
    document.getElementById("endScreen").classList.remove("hidden");
}

function revealImpostors(){
    let list=[];
    for(let i=0;i<roles.length;i++){
        if(roles[i]=="impostor") list.push("😈 "+players[i]);
    }
    const div=document.getElementById("impostorList");
    div.innerHTML=list.join("<br>");
    div.classList.remove("hidden");
}

function restartGame(){
    // Si categoría aleatoria está activada, cambiar categoría automáticamente
    if(randomCategoryEnabled) {
        const categories = Object.keys(wordCategories).filter(cat => cat !== "aleatorio");
        selectedCategory = categories[Math.floor(Math.random() * categories.length)];
        
        // Actualizar visualmente el select (aunque esté deshabilitado)
        document.getElementById("categorySelect").value = selectedCategory;
    }
    
    document.getElementById("impostorList").classList.add("hidden");
    document.getElementById("endScreen").classList.add("hidden");
    document.getElementById("setup").classList.remove("hidden");
}
/* ===== FUNCIONES PARA VOLVER ATRÁS ===== */
function goBack(fromScreen) {
    // Ocultar pantalla actual
    document.getElementById(fromScreen).classList.add("hidden");
    
    // Mostrar pantalla anterior según desde dónde venimos
    if(fromScreen === "names") {
        document.getElementById("setup").classList.remove("hidden");
    } else if(fromScreen === "roleScreen") {
        // Detener temporizador si existe (por si acaso)
        if (timerInterval) {
            clearInterval(timerInterval);
            timerInterval = null;
        }
        
        document.getElementById("names").classList.remove("hidden");
        // Mostrar los nombres que ya habíamos ingresado
        for(let i = 0; i < players.length; i++) {
            document.getElementById("name"+i).value = players[i];
        }
    }
    // NOTA: No manejamos 'setup' aquí porque es la pantalla inicial
}
function goToSetup() {
    // Detener el temporizador si está activo
    if (timerInterval) {
        clearInterval(timerInterval);
        timerInterval = null;
    }
    
    // Ocultar pantalla actual
    document.getElementById("endScreen").classList.add("hidden");
    
    // Mostrar configuración
    document.getElementById("setup").classList.remove("hidden");
}
toggleImpostorInput();
// Inicializar el switch de categoría aleatoria
toggleRandomCategory();
</script>
